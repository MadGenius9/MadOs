# MadOS image build configuration (sourced by scripts/*.sh and the Makefile).
# Product identity lives in product/product.toml, not here.

# Fedora release the image is based on. Fedora 44 is current stable
# (supported until ~2027-06). Bump deliberately; see ADR-001.
FEDORA_VERSION=44

# Bootable base image (KDE Plasma bootstrap desktop, see ADR-002).
BASE_IMAGE=quay.io/fedora-ostree-desktops/kinoite
# Optional digest pin for reproducible builds, e.g. sha256:abc... (empty = tag).
BASE_IMAGE_DIGEST=

# Container used to compile MadOS components against the same Fedora release.
BUILDER_IMAGE=quay.io/fedora/fedora

# Local name of the built OS container.
IMAGE_NAME=localhost/mados

# Registry reference installed systems will follow for updates (not
# published yet; see docs/architecture/ADR-004-updates.md).
UPDATE_IMAGE_REF=ghcr.io/madgenius9/mados

# osbuild image-builder (successor of bootc-image-builder).
IMAGE_BUILDER=ghcr.io/osbuild/image-builder-cli:latest

# Base for the experimental Anaconda installer ISO.
INSTALLER_BASE_IMAGE=quay.io/fedora/fedora-bootc

# Root filesystem for disk images.
ROOTFS=xfs

# Disk image size for qcow2 output.
DISK_SIZE=40G
