[Unit]
Description=System API service (mados-daemon)
Documentation=https://github.com/MadGenius9/MadOs/blob/master/docs/architecture/overview.md

[Service]
# Started on demand by D-Bus activation (org.mados.System1).
Type=dbus
BusName=org.mados.System1
ExecStart=/usr/libexec/mados/mados-daemon
SyslogIdentifier=mados-daemon
Restart=on-failure

# Hardening. The daemon runs bootc (status, upgrade, rollback) after its own
# polkit check, so its sandbox must let bootc reach the image registry and
# write the OSTree repository (/sysroot) and boot entries (/boot). That rules
# out PrivateNetwork= and ProtectSystem=; see docs/security.md. A dedicated,
# tighter update helper unit is planned (M7).
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
