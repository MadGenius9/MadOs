<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<!-- Generated from product/product.toml by scripts/stage-system.py. -->
<policyconfig>
  <vendor>@VENDOR@</vendor>
  <vendor_url>@VENDOR_URL@</vendor_url>

  <!-- Mirrors logind's defaults for power-off/reboot: the user at the active
       local session may, everyone else must authenticate as admin. -->
  <action id="org.mados.system.power">
    <description>Shut down or restart the system</description>
    <message>Authentication is required to shut down or restart the system</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!-- Fetching update metadata changes nothing on the system. -->
  <action id="org.mados.system.updates.check">
    <description>Check for operating system updates</description>
    <message>Authentication is required to check for operating system updates</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!-- Installing or rolling back the OS always needs an administrator. -->
  <action id="org.mados.system.updates.apply">
    <description>Install an operating system update or roll back</description>
    <message>Authentication is required to change the installed operating system</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
